{
  "name": "dsh-novelai",
  "version": "1.1.0",
  "description": "NovelAI 生图接入 DeepSeek Harness：nai_image / nai_status / nai_prompt 三个工具 + 画室页面 + 独立 studio，自带提示词知识库",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./nai": "./lib/nai.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "public",
    "docs",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "studio.mjs",
    "README.md"
  ],
  "bin": {
    "dsh-novelai-studio": "./studio.mjs"
  },
  "scripts": {
    "studio": "node studio.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "harness",
    "dsh",
    "novelai",
    "image-generation",
    "anime",
    "stable-diffusion",
    "prompt"
  ],
  "homepage": "https://github.com/ysiguu/dsh-novelai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysiguu/dsh-novelai.git"
  }
}
